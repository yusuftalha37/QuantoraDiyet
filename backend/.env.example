# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS (mobile app / web)
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quantoradiyet

# ---- JWT ----
# Generate strong random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)

# ---- Security ----
BCRYPT_ROUNDS=12
# Global rate limit: max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limit for auth endpoints
AUTH_RATE_LIMIT_MAX=10

# ---- AI provider (Anthropic). Leave empty to force the offline fallback engine ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=30000
